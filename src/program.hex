# program.hex — tests branch flush 
00500093   # ADDI x1, x0, 5     → x1 = 5
00500113   # ADDI x2, x0, 5     → x2 = 5
00208463   # BEQ  x1, x2, +8    → TAKEN (x1==x2), skip next 2
00C00193   # ADDI x3, x0, 12    → FLUSHED — x3 stays 0
00A00213   # ADDI x4, x0, 10    → FLUSHED — x4 stays 0
00F00293   # ADDI x5, x0, 15    → branch target, x5 = 15
00500313   # ADDI x6, x0, 5     → x6 = 5
00300393   # ADDI x7, x0, 3     → x7 = 3
00730863   # BEQ  x6, x7, +16   → NOT TAKEN (x6 != x7)
00800413   # ADDI x8, x0, 8     → executes normally, x8 = 8