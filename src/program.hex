# program.hex — tests EX→EX and MEM→EX forwarding
00500093   # ADDI x1, x0, 5     → x1 = 5
00108133   # ADD  x2, x1, x1    → x2 = 10  (EX→EX forward x1)
00210133   # ADD  x2, x2, x2    → x2 = 20  (EX→EX forward x2)
00500293   # ADDI x5, x0, 5     → x5 = 5   (no dependency)
002281B3   # ADD  x3, x5, x2    → x3 = 25  (MEM→EX forward x2, EX→EX forward x5)
00300213   # ADDI x4, x0, 3     → x4 = 3   (no dependency)
004201B3   # ADD  x3, x4, x4    → x3 = 6   (EX→EX forward x4)